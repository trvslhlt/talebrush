# Copy this file to .env and fill in your key. .env is git-ignored; never commit a real key.

# Claude API key from the Claude Console (platform.claude.com > API keys). Starts with sk-ant-.
ANTHROPIC_API_KEY=

# Models used by TaleBrush_Backend/server_llm.py. Leave as is unless you want to experiment.
GEN_MODEL=claude-sonnet-5-5
SCORE_MODEL=claude-haiku-5-5

# on: the models reason briefly before answering (default). off: skip reasoning for lower latency.
THINKING=on

# Candidate sentences per generation round, and the maximum rounds per sentence.
NUM_CANDIDATES=3
MAX_ROUNDS=3
